# Secrets are managed in Doppler (project: protash), not .env files.
#
#   doppler login
#   doppler setup          # picks up doppler.yaml -> protash / dev
#   npm run dev            # scripts already wrap commands in `doppler run`
#
# This file is kept only as a reference of the variables the app reads.
# To run without Doppler, copy it to .env.local and fill in real values.

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional board persistence mode:
# - file: persists to .data/board.json (best for local development)
# - memory: deploy-safe, but board state resets with serverless cold starts / restarts
# Default behavior:
# - local development -> file
# - production -> memory
# BOARD_STORAGE_MODE=memory
